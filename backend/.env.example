SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
LEGACY_CLINIC_OWNER_EMAIL=founder@yourdomain.com
GEMINI_API_KEY=your_gemini_api_key

KAPSO_API_KEY=your_kapso_project_api_key
KAPSO_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
KAPSO_VERSION=v24.0
KAPSO_WEBHOOK_SECRET=your_kapso_webhook_secret

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Temporary receiving clinic for public Telegram intake.
TELEGRAM_INTAKE_CLINIC_ID=your_clinic_uuid
# Maximum time an owner waits for AI before Kizuna uses its safety fallback.
TELEGRAM_RESPONSE_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local ASR through parakeet.cpp
PARAKEET_CLI_PATH=C:\path\to\parakeet-cli.exe
PARAKEET_MODEL_PATH=C:\path\to\tdt_ctc-110m-q5_k.gguf
PARAKEET_LANGUAGE=en-US
PARAKEET_TIMEOUT_SECONDS=180
SCRIBE_AUDIO_MAX_BYTES=104857600

# Structured SOAP generation through llama.cpp or another compatible server
SCRIBE_LLM_BASE_URL=http://127.0.0.1:8081/v1
SCRIBE_LLM_MODEL=gemma-4-12b-it-qat-q4_0
SCRIBE_LLM_API_KEY=
SCRIBE_LLM_TIMEOUT_SECONDS=300

# WhatsApp owner/farmer intake through the same warm Gemma 4 server
CARE_ASSISTANT_LLM_BASE_URL=http://127.0.0.1:8081/v1
CARE_ASSISTANT_LLM_MODEL=gemma-4-12b-it-qat-q4_0
CARE_ASSISTANT_LLM_API_KEY=
CARE_ASSISTANT_LLM_TIMEOUT_SECONDS=300
CARE_ASSISTANT_AUTO_REPLY=true
